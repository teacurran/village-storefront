# Village Storefront Local Development Environment Configuration
#
# Copy this file to .env and customize values for your local environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control. It's already in .gitignore.
# These variables are sourced by Docker Compose and can be read by Quarkus.

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
DB_NAME=storefront_dev
DB_USER=appuser
DB_PASSWORD=apppass
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/storefront_dev

# ==============================================================================
# OBJECT STORAGE (MinIO - S3/R2 Compatible)
# ==============================================================================
# MinIO simulates Cloudflare R2 for local development
R2_ENDPOINT=http://localhost:9000
R2_BUCKET=village-media
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin
R2_REGION=auto

# MinIO service ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==============================================================================
# EMAIL CONFIGURATION (Mailhog)
# ==============================================================================
# Mailhog captures all outbound emails for testing
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAILHOG_UI_PORT=8025

# ==============================================================================
# STRIPE PAYMENT CONFIGURATION
# ==============================================================================
# Use test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_secret
STRIPE_WEBHOOK_SKIP=false
STRIPE_TEST_MODE=true

# ==============================================================================
# POS OFFLINE MASTER KEY
# ==============================================================================
# Base64-encoded 32-byte key for offline POS encryption
# Generate with: openssl rand -base64 32
POS_OFFLINE_MASTER_KEY=VmlsbGFnZVBPU09mZmxpbmVNYXN0ZXJLZXlfXzMyMDA=

# ==============================================================================
# MEDIA PROCESSING
# ==============================================================================
# Path to FFmpeg binary (used for video transcoding)
# macOS (Homebrew): /opt/homebrew/bin/ffmpeg
# Linux (apt): /usr/bin/ffmpeg
# Windows (manual install): C:/ffmpeg/bin/ffmpeg.exe
MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg

# ==============================================================================
# OBSERVABILITY (Optional)
# ==============================================================================
# OpenTelemetry configuration for Jaeger tracing
# Start Jaeger with: docker compose --profile observability up -d
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317

# ==============================================================================
# QUARKUS APPLICATION
# ==============================================================================
QUARKUS_HTTP_PORT=8080

# ==============================================================================
# JWT CONFIGURATION (Development Only)
# ==============================================================================
# Generate keys with: openssl genrsa -out privateKey.pem 2048
#                     openssl rsa -in privateKey.pem -pubout -out publicKey.pem
JWT_ISSUER=https://village-storefront.local
JWT_PUBLIC_KEY_PATH=publicKey.pem
JWT_PRIVATE_KEY_PATH=privateKey.pem

# ==============================================================================
# FEATURE FLAGS (Development Overrides)
# ==============================================================================
# Comma-separated list of feature flags to enable in dev mode
# Example: FF_ENABLE=advanced_search,gift_cards,pos_offline
FF_ENABLE=

# ==============================================================================
# NOTES
# ==============================================================================
# - All services are accessible at localhost on the ports defined above
# - MinIO Console: http://localhost:9001 (login: minioadmin / minioadmin)
# - Mailhog UI: http://localhost:8025
# - Jaeger UI: http://localhost:16686 (requires --profile observability)
# - PostgreSQL: psql -h localhost -U appuser -d storefront_dev
#
# After modifying this file:
# 1. Restart Docker Compose: docker compose down && docker compose up -d
# 2. Restart Quarkus dev mode if running: Press 's' in terminal to restart
