from pathlib import Path
root = Path('modules/core-platform/src/main/resources/db/migrations')
marker = '\\n-- +migrate Down'
for path in root.glob('V*.sql'):
    text = path.read_text()
    idx = text.find(marker)
    if idx == -1:
        continue
    new_text = text[:idx].rstrip() + '\\n\\n-- Down migration handled via MyBatis migrations (omitted in Flyway).\\n'
    path.write_text(new_text)
    print('Trimmed down section in', path.name)
PY"
