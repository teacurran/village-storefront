title Village Storefront - Component Diagram (C4 Level 3)\nQuarkus Application Internal Architecture

' ============================================================================
' EXTERNAL ACTORS (Abbreviated)
' ============================================================================
Person(customer, "Customer", "Storefront user")
Person(merchant, "Merchant", "Admin user")
Person(staff, "Store Staff", "Works orders/inventory via admin")
Person(platformAdmin, "Platform Admin", "SaaS operator using platform console")
Person(headlessPartner, "Partner", "API consumer")

' ============================================================================
' CONTAINER BOUNDARY: Quarkus Application
' ============================================================================
Container_Boundary(quarkusApp, "Quarkus Application") {

    ' PRESENTATION LAYER COMPONENTS
    Component(quteEngine, "Qute Rendering Engine", "Qute", "Server-side template rendering for storefront pages with tenant branding tokens, PrimeUI hydration")
    Component(restResources, "REST API Resources", "RESTEasy Reactive", "OpenAPI-documented endpoints (/api/v1/*) for admin, headless, webhooks")
    Component(vueAssets, "Admin SPA Assets", "Static Files", "Compiled Vue.js bundles served under /admin/* via Quinoa")

    ' TENANT ACCESS GATEWAY (Cross-Cutting)
    Component(tenantFilter, "Tenant Resolution Filter", "JAX-RS Filter", "Extracts Host header, resolves subdomain/custom domain to Tenant, populates TenantContext")
    Component(tenantContext, "TenantContext", "ThreadLocal Holder", "Request-scoped tenant_id propagation to all layers")
    Component(featureFlagHydration, "Feature Flag Service", "CDI Bean", "Loads tenant-specific feature flags from DB + cache, evaluates toggles")

    ' IDENTITY & SESSION COMPONENTS
    Component(authService, "Authentication Service", "CDI Service", "JWT issuance/validation, refresh token rotation, OAuth client coordination")
    Component(sessionLogger, "Session Logger", "CDI Service", "Writes login/logout/impersonation events to session_log table for compliance")
    Component(impersonationController, "Impersonation Controller", "CDI Service", "Platform admin impersonation workflows with audit trail")

    ' CATALOG & INVENTORY COMPONENTS
    Component(catalogService, "Catalog Service", "CDI Service", "Product/variant CRUD, category hierarchies, collections, search event publishing")
    Component(inventoryService, "Inventory Service", "CDI Service", "Multi-location stock tracking, adjustments, transfers, low-stock alerts")
    Component(searchIndexer, "Search Indexer", "Event Listener", "Consumes product change events, updates search projections (future Elasticsearch)")

    ' CONSIGNMENT COMPONENTS
    Component(vendorService, "Vendor Service", "CDI Service", "Consignor onboarding, portal access, commission schedule management")
    Component(commissionCalculator, "Commission Calculator", "CDI Service", "Calculates splits per order line item based on vendor rules")
    Component(payoutOrchestrator, "Payout Orchestrator", "CDI Service", "Batches vendor payouts via Stripe Connect, records ledger entries")

    ' CHECKOUT & ORDER COMPONENTS
    Component(cartService, "Cart Service", "CDI Service", "Persistent cart management, line item validation, promo code application")
    Component(checkoutOrchestrator, "Checkout Orchestrator", "CDI Service", "Coordinates address validation, shipping, tax, payment, order creation")
    Component(orderService, "Order Service", "CDI Service", "Order lifecycle management, fulfillment status, tracking updates")
    Component(shipmentService, "Shipment Service", "CDI Service", "Carrier rate fetching, label generation, tracking webhook ingestion")
    Component(returnService, "Return Service", "CDI Service", "RMA creation, restocking, refund coordination")

    ' PAYMENT INTEGRATION COMPONENTS
    Component(paymentService, "Payment Service", "CDI Service", "Abstracts PaymentProvider interface, orchestrates intents, captures, refunds")
    Component(stripeAdapter, "Stripe Adapter", "CDI Service", "Implements PaymentProvider + MarketplaceProvider via Stripe SDK")
    Component(webhookProcessor, "Webhook Processor", "REST Resource", "Validates Stripe signatures, dispatches to domain event handlers")
    Component(ledgerService, "Ledger Service", "CDI Service", "Double-entry accounting for payments, refunds, payouts, store credit")

    ' LOYALTY & REWARDS COMPONENTS
    Component(loyaltyService, "Loyalty Service", "CDI Service", "Points accumulation, tier upgrades, expiration rules")
    Component(rewardRedemption, "Reward Redemption Engine", "CDI Service", "Applies loyalty discounts during checkout, validates balances")

    ' POS & OFFLINE COMPONENTS
    Component(posAPI, "POS API", "REST Resource", "Browser-based POS endpoints, hardware integration bridges (Stripe Terminal)")
    Component(offlineQueue, "Offline Queue Reconciler", "Scheduled Job", "Syncs queued sales from disconnected POS sessions")

    ' MEDIA PIPELINE COMPONENTS
    Component(mediaUploadController, "Media Upload Controller", "REST Resource", "Pre-signed upload URL generation, enforces size/type limits")
    Component(mediaPipeline, "Media Pipeline Coordinator", "CDI Service", "Enqueues FFmpeg jobs, tracks processing status, updates media_assets")

    ' REPORTING & ANALYTICS COMPONENTS
    Component(reportingProjections, "Reporting Projections", "Event Listener", "Builds read-optimized aggregates (sales, inventory, commissions)")
    Component(dashboardAPI, "Dashboard Metrics API", "REST Resource", "Exposes time-series data for admin widgets, exports CSV/PDF")

    ' PLATFORM ADMIN COMPONENTS
    Component(tenantLifecycleService, "Tenant Lifecycle Service", "CDI Service", "Store provisioning, plan changes, suspension, deletion")
    Component(platformMetrics, "Platform Metrics Aggregator", "Scheduled Job", "Cross-tenant health metrics, rate limit tracking")

    ' INTEGRATION ADAPTER LAYER
    Component(carrierAdapters, "Carrier Adapters", "CDI Services", "Unified interface for USPS/UPS/FedEx APIs with retry/fallback")
    Component(addressValidator, "Address Validator", "CDI Service", "Normalizes addresses via USPS/SmartyStreets")
    Component(taxAdapter, "Tax Service Adapter", "CDI Service", "Calculates sales tax via Avalara/TaxJar")
    Component(emailAdapter, "Email Adapter", "CDI Service", "Quarkus Mailer wrapper with domain filtering, template rendering")

    ' INFRASTRUCTURE PRIMITIVES
    Component(jobScheduler, "Background Job Scheduler", "Quarkus Scheduler", "Polls delayed_jobs table, invokes handlers with priority queues")
    Component(cacheManager, "Cache Manager", "Caffeine", "Tenant-aware cache key management, TTL policies, invalidation events")
    Component(eventBus, "Domain Event Bus", "CDI Events", "In-process publish/subscribe for cross-module notifications")
}

