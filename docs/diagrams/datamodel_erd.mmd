%% Village Storefront - Entity Relationship Diagram (Mermaid)
%% Version: Baseline (2026-01-08)
%% References:
%% - Architecture Overview: docs/architecture_overview.md Section 5
%% - Tenancy ADR: docs/adr/ADR-001-tenancy.md
%% - OpenAPI Contract: api/v1/openapi.yaml
%% - PlantUML ERD: docs/diagrams/datamodel_erd.puml
%% Conventions:
%% - All tenant-scoped tables include tenant_id (UUID FK → tenants)
%% - Audit columns: created_at, updated_at, created_by (TIMESTAMPTZ/UUID)
%% - Monetary values: NUMERIC mapped to Money schema in API (precision 19,4)
%% - Flexible data: JSONB columns for settings, metadata, addresses
%% - Soft deletes: status enum includes 'deleted' where applicable
%% RLS (Row-Level Security):
%% All tenant-scoped tables marked with [RLS] require policies per ADR-001
%% Policy template: USING (tenant_id = current_setting('app.current_tenant_id')::uuid)
%% Partitioning Strategy:
%% Tables marked with [PARTITIONED] use range partitioning by created_at
%% - session_log: Monthly partitions, 90-day retention
%% - audit_events: Monthly partitions, 1-year retention, archival to cold storage
%% - background_jobs: Weekly partitions, 30-day retention
%% Rendering:
%% mmdc -i docs/diagrams/datamodel_erd.mmd -o docs/diagrams/datamodel_erd.png

erDiagram

    %% ========================================
    %% TENANCY MODULE
    %% ========================================

    tenants {
        UUID id PK "Primary key"
        VARCHAR subdomain UK "Unique subdomain"
        VARCHAR name "Tenant display name"
        VARCHAR status "active|suspended|deleted"
        VARCHAR base_currency "ISO 4217 currency code"
        JSONB settings "Tenant-specific configuration"
        JSONB branding "Theme colors, logos, fonts"
        JSONB config_flags "Feature toggles per tenant"
        TIMESTAMPTZ created_at "Creation timestamp"
        TIMESTAMPTZ updated_at "Last update timestamp"
        TIMESTAMPTZ suspended_at "Suspension timestamp (nullable)"
    }

    custom_domains {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        VARCHAR domain UK "FQDN (RFC 1035)"
        BOOLEAN verified "Domain ownership verified"
        VARCHAR verification_token "DNS/HTTP verification token"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    %% ========================================
    %% IDENTITY MODULE
    %% ========================================

    store_users {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        VARCHAR email "Unique per tenant"
        VARCHAR hashed_password "bcrypt/argon2 hash"
        JSONB roles "Array of role strings"
        JSONB permissions "Granular permissions map"
        VARCHAR status "active|suspended|deleted"
        VARCHAR mfa_secret "TOTP secret (nullable)"
        JSONB staff_profile "Name, phone, metadata"
        TIMESTAMPTZ last_login_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    customers {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        VARCHAR email "Customer email (unique per tenant)"
        VARCHAR password_hash "Auth hash (nullable for guest)"
        VARCHAR name "Full name"
        JSONB addresses "Shipping/billing addresses array"
        VARCHAR phone
        INTEGER loyalty_balance "Points balance"
        JSONB preferences "Communication, marketing opts"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    session_log {
        UUID id PK "[PARTITIONED]"
        VARCHAR user_type "store_user|customer|guest"
        UUID user_id FK "→ store_users.id or customers.id (nullable)"
        UUID tenant_id FK "→ tenants.id [RLS]"
        INET ip "Client IP address"
        TEXT user_agent "Client user agent"
        VARCHAR device_fingerprint "Browser fingerprint hash"
        TIMESTAMPTZ login_at "Session start"
        TIMESTAMPTZ last_activity_at "Last request timestamp"
        VARCHAR logout_reason "manual|timeout|forced|impersonation_end"
        JSONB impersonation_context "Actor details if impersonated"
        TIMESTAMPTZ created_at
    }

    api_keys {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        UUID user_id FK "→ store_users.id (nullable)"
        VARCHAR key_hash "SHA256 hash of API key"
        VARCHAR key_prefix "First 8 chars for identification"
        VARCHAR name "Human-readable key name"
        JSONB scopes "Allowed API operations"
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ last_used_at
        VARCHAR status "active|revoked"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    %% ========================================
    %% CATALOG MODULE
    %% ========================================

    categories {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        UUID parent_id FK "→ categories.id (nullable, self-ref)"
        VARCHAR code UK "Unique code per tenant"
        VARCHAR name
        VARCHAR slug UK "URL slug per tenant"
        TEXT description
        INTEGER display_order
        VARCHAR status "active|deleted"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    products {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        VARCHAR title "Product display title"
        VARCHAR slug UK "URL slug per tenant"
        TEXT description "Rich text description"
        VARCHAR status "draft|active|archived|deleted"
        JSONB visibility_window "start_date, end_date"
        JSONB seo "title, description, keywords"
        JSONB category_ids "Array of category UUIDs"
        JSONB collection_ids "Array of collection UUIDs"
        JSONB custom_attributes "Extensible metadata"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    variants {
        UUID id PK
        UUID product_id FK "→ products.id"
        UUID tenant_id FK "→ tenants.id [RLS]"
        VARCHAR sku UK "Unique per tenant"
        VARCHAR barcode
        JSONB option_values "Size, color, etc."
        NUMERIC price
        NUMERIC compare_at_price
        VARCHAR inventory_policy "continue|deny"
        NUMERIC weight
        JSONB dimensions "length, width, height"
        JSONB media_ids "Array of MediaAsset UUIDs"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    inventory_locations {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        VARCHAR name "Location display name"
        JSONB address "Structured address object"
        VARCHAR type "warehouse|retail|dropship|consignor"
        INTEGER capacity "Max units (nullable)"
        VARCHAR timezone "IANA timezone"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    inventory_levels {
        UUID id PK
        UUID variant_id FK "→ variants.id"
        UUID location_id FK "→ inventory_locations.id"
        UUID tenant_id FK "→ tenants.id [RLS]"
        INTEGER on_hand "Physical quantity"
        INTEGER reserved "Allocated to orders"
        INTEGER incoming "Purchase orders in transit"
        INTEGER safety_stock "Reorder threshold"
        INTEGER low_stock_threshold "Alert threshold"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    product_categories {
        UUID tenant_id FK "→ tenants.id [RLS]"
        UUID product_id FK "→ products.id"
        UUID category_id FK "→ categories.id"
        INTEGER display_order
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    %% ========================================
    %% CART/ORDER/PAYMENT MODULE
    %% ========================================

    carts {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        UUID customer_id FK "→ customers.id (nullable, guest carts)"
        JSONB items "Array of cart items"
        JSONB discounts "Applied discount codes"
        JSONB shipping_address
        JSONB billing_address
        VARCHAR currency "ISO 4217 code"
        NUMERIC subtotal "Pre-tax, pre-shipping"
        NUMERIC tax_total
        NUMERIC shipping_total
        NUMERIC grand_total
        TIMESTAMPTZ last_activity_at "TTL for cart expiration"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    orders {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        VARCHAR order_number UK "Human-readable order ID per tenant"
        UUID customer_id FK "→ customers.id"
        JSONB cart_snapshot "Immutable cart state at checkout"
        VARCHAR status "pending|confirmed|processing|shipped|delivered|cancelled|refunded"
        VARCHAR payment_state "unpaid|authorized|paid|partially_refunded|refunded"
        VARCHAR fulfillment_state "unfulfilled|partial|fulfilled|returned"
        JSONB shipping_address
        JSONB billing_address
        JSONB totals "Subtotal, tax, shipping, grand_total"
        JSONB timeline "Status change events array"
        TEXT notes "Customer-facing notes"
        JSONB tags "Internal categorization"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    order_line_items {
        UUID id PK
        UUID order_id FK "→ orders.id"
        UUID variant_id FK "→ variants.id"
        UUID tenant_id FK "→ tenants.id [RLS]"
        INTEGER quantity
        NUMERIC unit_price "Price at time of order"
        JSONB totals "Line-level tax, discounts"
        JSONB product_snapshot "Product/variant state at purchase"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    payment_intents {
        UUID id PK
        UUID order_id FK "→ orders.id"
        UUID tenant_id FK "→ tenants.id [RLS]"
        VARCHAR provider "stripe|square|manual"
        VARCHAR provider_reference "External transaction ID"
        NUMERIC amount
        VARCHAR currency
        NUMERIC application_fee "Platform fee"
        VARCHAR status "pending|processing|succeeded|failed|cancelled"
        TIMESTAMPTZ captured_at
        TEXT failure_reason
        JSONB metadata
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    refunds {
        UUID id PK
        UUID payment_intent_id FK "→ payment_intents.id"
        UUID tenant_id FK "→ tenants.id [RLS]"
        NUMERIC amount
        VARCHAR currency
        TEXT reason "Customer reason code"
        TIMESTAMPTZ processed_at
        VARCHAR provider_reference
        VARCHAR status "pending|processing|succeeded|failed"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    shipments {
        UUID id PK
        UUID order_id FK "→ orders.id"
        UUID tenant_id FK "→ tenants.id [RLS]"
        VARCHAR carrier "usps|ups|fedex|dhl"
        VARCHAR service_level "standard|express|overnight"
        VARCHAR tracking_number
        JSONB labels "Array of label URLs"
        JSONB packages "Box dimensions, weights"
        VARCHAR status "pending|in_transit|delivered|failed"
        TIMESTAMPTZ shipped_at
        TIMESTAMPTZ delivered_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    return_authorizations {
        UUID id PK
        UUID order_id FK "→ orders.id"
        UUID tenant_id FK "→ tenants.id [RLS]"
        JSONB items "Returned line items"
        JSONB reason_codes "Return reasons per item"
        VARCHAR status "requested|approved|received|restocked|rejected"
        UUID approved_by FK "→ store_users.id (nullable)"
        TIMESTAMPTZ received_at
        VARCHAR restock_decision "restock|discard|quarantine"
        NUMERIC refund_amount
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    %% ========================================
    %% CONSIGNMENT MODULE
    %% ========================================

    consignors {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        JSONB contact "Name, email, phone"
        JSONB tax_info "SSN/EIN, W9 data"
        JSONB commission_rules "Percentage by category/tier"
        JSONB payout_preferences "ACH, PayPal, check"
        VARCHAR portal_access_token "Portal login token hash"
        VARCHAR status "active|suspended|deleted"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    consignment_items {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        UUID variant_id FK "→ variants.id"
        UUID consignor_id FK "→ consignors.id"
        NUMERIC cost_basis "Consignor's cost"
        TIMESTAMPTZ received_at
        TIMESTAMPTZ expires_at "Consignment agreement expiry"
        VARCHAR status "available|sold|returned|expired"
        INTEGER aging_days "Days since received"
        VARCHAR payout_state "pending|paid"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    consignor_payouts {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        UUID consignor_id FK "→ consignors.id"
        DATE period_start
        DATE period_end
        NUMERIC total_amount
        VARCHAR currency
        VARCHAR status "pending|processing|completed|failed"
        TIMESTAMPTZ processed_at
        VARCHAR payment_reference
        JSONB line_items "Array of sold items"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    %% ========================================
    %% LOYALTY MODULE
    %% ========================================

    loyalty_ledger_entries {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        UUID customer_id FK "→ customers.id"
        INTEGER points_delta "Positive=earn, negative=redeem"
        TEXT reason "Order earn, redemption, manual adjustment"
        UUID order_id FK "→ orders.id (nullable)"
        INTEGER balance_after "Running balance snapshot"
        TIMESTAMPTZ expires_at "Point expiration (nullable)"
        VARCHAR source "order|promotion|manual|expiration"
        TIMESTAMPTZ created_at
    }

    %% ========================================
    %% GIFT CARDS & STORE CREDIT MODULE
    %% ========================================

    gift_cards {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        VARCHAR code UK "Redemption code per tenant"
        NUMERIC initial_balance
        NUMERIC current_balance
        VARCHAR currency
        UUID customer_id FK "→ customers.id (nullable, recipient)"
        TIMESTAMPTZ expires_at
        VARCHAR status "active|redeemed|expired|cancelled"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    store_credits {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        UUID customer_id FK "→ customers.id"
        NUMERIC amount
        VARCHAR currency
        TEXT reason "Refund, compensation, promotion"
        UUID order_id FK "→ orders.id (nullable)"
        TIMESTAMPTZ expires_at
        VARCHAR status "active|used|expired"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    %% ========================================
    %% MEDIA MODULE
    %% ========================================

    media_assets {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        VARCHAR storage_key "Object storage path (tenant_id/media_type/hash/file)"
        VARCHAR filename "Original filename"
        VARCHAR mime_type "image/jpeg, video/mp4, etc."
        VARCHAR media_type "product_image|logo|banner|document"
        INTEGER file_size "Bytes"
        INTEGER width "Pixels (nullable, images only)"
        INTEGER height "Pixels (nullable, images only)"
        JSONB variants "Processed sizes/formats"
        VARCHAR status "processing|ready|failed"
        JSONB metadata "EXIF, alt_text, copyright"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    %% ========================================
    %% CROSS-CUTTING TABLES
    %% ========================================

    feature_flags {
        UUID id PK
        UUID tenant_id FK "→ tenants.id (nullable, platform defaults) [RLS]"
        VARCHAR key UK "Global or tenant-specific flag key"
        TEXT description
        BOOLEAN default_state "Global default"
        JSONB allowed_audiences "Tenant IDs, user roles"
        JSONB targeting_rules "Audience/percentage rollouts"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    audit_events {
        UUID id PK "[PARTITIONED]"
        UUID tenant_id FK "→ tenants.id (nullable, platform events) [RLS]"
        VARCHAR actor_type "store_user|customer|system"
        UUID actor_id "→ store_users.id or customers.id (nullable)"
        VARCHAR action "create|update|delete|view|export"
        VARCHAR target_type "product|order|customer|setting"
        UUID target_id "Entity UUID"
        JSONB metadata "Changed fields, IP, user_agent"
        JSONB impersonation_context "Impersonator details (nullable)"
        TIMESTAMPTZ occurred_at
        TIMESTAMPTZ created_at
    }

    background_jobs {
        UUID id PK "[PARTITIONED]"
        VARCHAR queue "default|import|export|email|media"
        INTEGER priority "1=highest, 10=lowest"
        JSONB payload "Handler class, arguments"
        INTEGER attempts "Retry count"
        TEXT last_error "Last failure message"
        TIMESTAMPTZ run_at "Scheduled execution time"
        UUID locked_by "Worker ID (nullable)"
        TIMESTAMPTZ locked_at
        TIMESTAMPTZ finished_at
        UUID tenant_id FK "→ tenants.id (nullable, platform jobs) [RLS]"
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    webhook_events {
        UUID id PK
        UUID tenant_id FK "→ tenants.id [RLS]"
        VARCHAR provider "stripe|shippo|mailgun"
        VARCHAR event_type "payment.succeeded, shipment.delivered"
        JSONB payload "Raw webhook body"
        VARCHAR idempotency_key UK "Provider event ID"
        VARCHAR status "pending|processed|failed|ignored"
        TEXT processing_error
        INTEGER attempts
        TIMESTAMPTZ processed_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    domain_events {
        UUID id PK "[PARTITIONED]"
        UUID tenant_id FK "→ tenants.id (nullable, platform events) [RLS]"
        VARCHAR event_type "OrderPlaced, InventoryUpdated, etc."
        UUID aggregate_id "Entity UUID"
        VARCHAR aggregate_type "Order, Product, Customer"
        JSONB payload "Event data"
        UUID caused_by FK "→ store_users.id or customers.id (nullable)"
        TIMESTAMPTZ occurred_at
        TIMESTAMPTZ created_at
    }

    platform_commands {
        UUID id PK
        UUID tenant_id FK "→ tenants.id (nullable, platform-level commands) [RLS]"
        VARCHAR command_type "SuspendTenant, MigrateTenant, etc."
        JSONB payload "Command arguments"
        VARCHAR status "pending|processing|completed|failed"
        UUID executed_by FK "→ store_users.id (platform admin)"
        TIMESTAMPTZ executed_at
        TEXT execution_result
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    rate_limit_buckets {
        UUID id PK
        VARCHAR key UK "API endpoint or action identifier"
        UUID tenant_id FK "→ tenants.id (nullable, platform-level limits) [RLS]"
        UUID user_id FK "→ store_users.id or customers.id (nullable)"
        INTEGER tokens "Remaining tokens in bucket"
        INTEGER capacity "Max tokens (burst size)"
        NUMERIC refill_rate "Tokens per second"
        TIMESTAMPTZ last_refill_at
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    %% ========================================
    %% RELATIONSHIPS
    %% ========================================

    %% Tenancy relationships
    tenants ||--o{ custom_domains : "has many"
    tenants ||--o{ store_users : "has many"
    tenants ||--o{ customers : "has many"
    tenants ||--o{ session_log : "has many"
    tenants ||--o{ api_keys : "has many"

    %% Catalog relationships
    tenants ||--o{ categories : "has many"
    categories ||--o{ categories : "parent-child"
    tenants ||--o{ products : "has many"
    products ||--o{ variants : "has many"
    products ||--o{ product_categories : "belongs to"
    categories ||--o{ product_categories : "has many"
    tenants ||--o{ inventory_locations : "has many"
    variants ||--o{ inventory_levels : "has many"
    inventory_locations ||--o{ inventory_levels : "has many"

    %% Cart/Order relationships
    tenants ||--o{ carts : "has many"
    customers ||--o{ carts : "has many"
    tenants ||--o{ orders : "has many"
    customers ||--o{ orders : "has many"
    orders ||--o{ order_line_items : "has many"
    variants ||--o{ order_line_items : "references"
    orders ||--o{ payment_intents : "has many"
    payment_intents ||--o{ refunds : "has many"
    orders ||--o{ shipments : "has many"
    orders ||--o{ return_authorizations : "has many"

    %% Consignment relationships
    tenants ||--o{ consignors : "has many"
    tenants ||--o{ consignment_items : "has many"
    variants ||--o{ consignment_items : "references"
    consignors ||--o{ consignment_items : "owns"
    tenants ||--o{ consignor_payouts : "has many"
    consignors ||--o{ consignor_payouts : "receives"

    %% Loyalty relationships
    tenants ||--o{ loyalty_ledger_entries : "has many"
    customers ||--o{ loyalty_ledger_entries : "earns/redeems"
    orders ||--o{ loyalty_ledger_entries : "generates"

    %% Gift Cards & Store Credit relationships
    tenants ||--o{ gift_cards : "has many"
    customers ||--o{ gift_cards : "recipient"
    tenants ||--o{ store_credits : "has many"
    customers ||--o{ store_credits : "has many"
    orders ||--o{ store_credits : "generates"

    %% Media relationships
    tenants ||--o{ media_assets : "has many"
    variants ||--o{ media_assets : "references"

    %% Cross-cutting relationships
    tenants ||--o{ audit_events : "has many (nullable)"
    tenants ||--o{ background_jobs : "has many (nullable)"
    tenants ||--o{ webhook_events : "has many"
    tenants ||--o{ domain_events : "has many (nullable)"
    tenants ||--o{ platform_commands : "receives (nullable)"
    tenants ||--o{ rate_limit_buckets : "has many (nullable)"
    tenants ||--o{ feature_flags : "overrides (nullable)"

    store_users ||--o{ api_keys : "owns"
    store_users ||--o{ session_log : "authenticated as"
    customers ||--o{ session_log : "authenticated as"
    store_users ||--o{ return_authorizations : "approves"
    store_users ||--o{ audit_events : "performs"
    customers ||--o{ audit_events : "performs"
    store_users ||--o{ domain_events : "causes"
    customers ||--o{ domain_events : "causes"
    store_users ||--o{ platform_commands : "executes"
    store_users ||--o{ rate_limit_buckets : "rate limited"
    customers ||--o{ rate_limit_buckets : "rate limited"
