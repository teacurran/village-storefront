' ============================================================================
' PLATFORM-OPS MODULE - Background jobs, domain events, audit logs, feature flags
' ============================================================================
package "Platform-Ops Module" as PlatformOpsModule #FADBD8 {
  entity "background_jobs" as background_jobs <<RLS>> {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID <<FK>>
    * queue : VARCHAR(100)
    * handler_class : VARCHAR(255)
    payload : JSONB
    * status : VARCHAR(20)
    attempts : INTEGER
    max_attempts : INTEGER
    last_error : TEXT
    run_at : TIMESTAMPTZ
    locked_until : TIMESTAMPTZ
    locked_by : VARCHAR(255)
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
    --
    **Status Values:** pending | locked | processing |
                       completed | failed
    **Indexes:**
    - INDEX(tenant_id, queue, status, run_at)
    - INDEX(status, run_at) - worker polling
    - INDEX(locked_until) - lock expiration cleanup
  }

  note right of background_jobs
    **Background Job Queue (Database-Backed)**
    - Queue: Logical queue name (default, media, payouts, emails)
    - Handler Class: Full Java class name for job processor
    - Payload JSONB: Job parameters (tenant_id, entity_id, etc.)
    - Run At: Scheduled execution time (NULL = immediate)
    - Locked Until: Optimistic locking for distributed workers
    - Locked By: Worker ID that claimed the job

    **Tenant Isolation & Indexes:**
    - tenant_id enforces per-tenant queue isolation when shared DB used
    - idx_background_jobs_queue_status (tenant_id, queue, status, run_at)
    - idx_background_jobs_worker (status, run_at) keeps cross-tenant workers efficient
    - idx_background_jobs_lock_expiry (locked_until) clears stale locks

    **Job Processing:**
    - Workers poll: WHERE status='pending' AND run_at <= NOW()
    - Acquire lock: UPDATE ... SET locked_until = NOW() + interval
    - Execute handler: Reflect.invoke(handlerClass, payload)
    - Update status: completed | failed (with retry logic)

    **Queues:**
    - default: General-purpose jobs
    - media: Image/video processing (FFmpeg)
    - payouts: Consignment payout batch processing
    - emails: Transactional email delivery
    - reports: Scheduled report generation
    - cleanup: Data archival, cache warming

    **No External Broker:**
    - PostgreSQL-backed queue eliminates Redis/RabbitMQ dependency
    - SKIP LOCKED for concurrent worker polling
    - Automatic retry with exponential backoff
  end note

  entity "domain_events" as domain_events <<RLS>> {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID <<FK>>
    * event_type : VARCHAR(100)
    * aggregate_type : VARCHAR(100)
    * aggregate_id : UUID
    * payload : JSONB
    * published_at : TIMESTAMPTZ
    * created_at : TIMESTAMPTZ
    --
    **Indexes:**
    - INDEX(tenant_id, aggregate_type, aggregate_id, published_at)
    - INDEX(tenant_id, event_type, published_at)
    - INDEX(published_at DESC) - event replay
  }

  note right of domain_events
    **Domain Event Sourcing**
    - Event Type: OrderPlaced, PaymentProcessed, etc.
    - Aggregate Type: Order, Payment, Product
    - Aggregate ID: Entity UUID
    - Payload JSONB: Event data snapshot
    - Published At: Event timestamp (immutable)

    **Event Sourcing Patterns:**
    - Immutable append-only log
    - Event replay for projections
    - Audit trail for debugging

    **Example Events:**
    - OrderPlaced, OrderConfirmed, OrderShipped
    - PaymentSucceeded, PaymentFailed
    - ConsignmentItemSold, PayoutBatchCreated

    **Future Integration:**
    - Kafka/Pulsar publishing for external consumers
    - Event-driven microservices decomposition
  end note

  entity "audit_log_entries" as audit_log_entries <<RLS>> <<PARTITIONED>> {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID <<FK>>
    user_id : UUID <<FK>>
    * action : VARCHAR(100)
    entity_type : VARCHAR(100)
    entity_id : UUID
    changes : JSONB
    ip_address : INET
    user_agent : TEXT
    * created_at : TIMESTAMPTZ
    --
    **Partitioning:** RANGE on created_at (weekly)
    **Retention:** 2 years, auto-archival to S3
    **Indexes:**
    - INDEX(tenant_id, user_id, created_at DESC)
    - INDEX(tenant_id, entity_type, entity_id, created_at DESC)
    - INDEX(tenant_id, action, created_at DESC)
  }

  note right of audit_log_entries
    **Audit Logging & Compliance**
    - Action: CRUD operation (create, update, delete, read)
    - Entity Type: Table/model name
    - Entity ID: Record UUID
    - Changes JSONB: {before: {...}, after: {...}}
    - IP Address: Client IP (for security forensics)
    - User Agent: Browser/API client identifier

    **RISK-001 Mitigation:**
    - All tenant access logged with IP + user-agent
    - Impersonation events flagged for security review
    - Failed authentication attempts tracked

    **Partitioning Strategy:**
    - Weekly range partitions: audit_2026_w01, audit_2026_w02
    - Automatic partition creation via pg_cron
    - Old partitions exported to S3 after 2 years

    **Compliance:**
    - GDPR right to erasure: Redact user data in changes JSONB
    - Retention policy: 2 years active, 7 years archive
  end note

  entity "feature_flags" as feature_flags <<RLS>> {
    * **id** : UUID <<PK>>
    --
    * tenant_id : UUID <<FK>>
    * flag_key : VARCHAR(100)
    * enabled : BOOLEAN
    config : JSONB
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
    --
    <<UNIQUE (tenant_id, flag_key)>>
    **Indexes:**
    - UNIQUE(tenant_id, flag_key)
    - INDEX(enabled) - active flag queries
  }

  note right of feature_flags
    **Feature Flag Management**
    - Flag Key: Dotted identifier (e.g., catalog.import.enabled)
    - Enabled: Boolean toggle (per tenant)
    - Config JSONB: Rollout percentage, targeting rules

    **Kill Switch Pattern:**
    - Disable features without code deployment
    - Rollout: 0% → 10% → 50% → 100% users
    - A/B testing: Split traffic by user segment

    **Caffeine Caching:**
    - Flags cached in-memory per tenant
    - Cache invalidation on flag update (CDI event)
    - Fallback to database if cache miss

    **Example Flags:**
    - tenant.media.video_processing (enable FFmpeg jobs)
    - catalog.import.batch_size (config: {size: 1000})
    - checkout.stripe.enabled (payment provider toggle)
  end note

  tenants ||--o{ background_jobs : "has many (nullable)"
  tenants ||--o{ domain_events : "has many (nullable)"
  tenants ||--o{ audit_log_entries : "has many (nullable)"
  users ||--o{ audit_log_entries : "has many (nullable)"
  tenants ||--o{ feature_flags : "has many (nullable)"
}

