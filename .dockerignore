# Docker build context exclusions
# Reduces build context size and speeds up docker build

# Target directories (build artifacts)
target/
**/target/

# Node.js
node_modules/
**/node_modules/
dist/
**/dist/

# IDE files
.idea/
.vscode/
*.iml
.project
.classpath
.settings/

# Version control
.git/
.gitignore
.gitattributes

# Documentation
docs/
*.md
!pom.xml

# Test files
**/src/test/

# CI/CD
.github/
.codemachine/

# Local environment
.env
.env.local
*.log

# Kubernetes manifests (not needed in image)
k8s/
infra/

# Database migrations (run separately)
migrations/

# Docker
Dockerfile
.dockerignore
docker-compose.yml
